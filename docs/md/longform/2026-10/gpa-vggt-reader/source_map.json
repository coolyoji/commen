  "blocks": [
    {
      "id": "S001",
      "page": 1,
      "type": "note",
      "order": 1,
      "original_text": "",
      "english_paraphrase": "GPA-VGGT accelerates a pretrained geometry transformer without additional training by preserving queries and compressing context selectively.",
      "translation": "GPA-VGGT 不额外训练，保留所有 query，并选择性压缩被查询的上下文，减少几何 Transformer 的推理时间。",
      "source_kind": "paper-grounded-paraphrase",
      "confidence": "high",
      "bbox": null,
      "bbox_note": "section/page anchor; paragraph bbox not claimed"
    },
    {
      "id": "S002",
      "page": 3,
      "type": "note",
      "order": 2,
      "original_text": "",
      "english_paraphrase": "Merging queries ties outputs of distinct locations. Omitting group sizes also redistributes attention, so dense geometry can degrade through different mechanisms.",
      "translation": "合并 query 会让不同位置共享输出；省略组大小又会重新分配注意力。两条路径都能损伤稠密几何。",
      "source_kind": "paper-grounded-paraphrase",
      "confidence": "high",
      "bbox": null,
      "bbox_note": "section/page anchor; paragraph bbox not claimed"
    },
    {
      "id": "C001",
      "page": 3,
      "type": "caption",
      "order": 3,
      "original_text": "",
      "english_paraphrase": "Fig.2: output diversity and attention mass",
      "translation": "上：是否合并query影响输出多样性；下：log-size补偿影响各帧的注意力分配。",
      "confidence": "high",
      "bbox": null
    },
    {
      "id": "S003",
      "page": 5,
      "type": "note",
      "order": 4,
      "original_text": "",
      "english_paraphrase": "Early blocks use frame attention with shared pooled context. Later blocks merge keys and values, retain every query, and reduce merging in sensitive middle blocks.",
      "translation": "早期层使用帧内 attention 与共享 pooled context；后期层只合并 keys/values，保留 query，并对敏感中间层减少合并。",
      "source_kind": "paper-grounded-paraphrase",
      "confidence": "high",
      "bbox": null,
      "bbox_note": "section/page anchor; paragraph bbox not claimed"
    },
    {
      "id": "C002",
      "page": 5,
      "type": "caption",
      "order": 5,
      "original_text": "",
      "english_paraphrase": "Fig.4: architecture and merging pathways",
      "translation": "GPA-VGGT整体结构：早期共享跨帧K/V；后期保query、合并K/V并加log-size。",
      "confidence": "high",
      "bbox": null
    },
    {
      "id": "S004",
      "page": 8,
      "type": "note",
      "order": 6,
      "original_text": "",
      "english_paraphrase": "At two hundred frames runtime decreases from 86.78 to 33.65 seconds. Accuracy remains close to the baseline under the reported evaluation settings.",
      "translation": "200帧时间从86.78秒降到33.65秒；在论文评测设置下精度接近原模型。",
      "source_kind": "paper-grounded-paraphrase",
      "confidence": "high",
      "bbox": null,
      "bbox_note": "section/page anchor; paragraph bbox not claimed"
    },
    {
      "id": "S005",
      "page": 10,
      "type": "note",
      "order": 7,
      "original_text": "",
      "english_paraphrase": "Peak memory remains almost unchanged because full-length feed-forward activations remain. Separate ablations support both query preservation and size correction.",
      "translation": "峰值显存几乎不变，因为全长FFN激活仍保留；组合消融支持保query和大小补偿各自的作用。",
      "source_kind": "paper-grounded-paraphrase",
      "confidence": "high",
      "bbox": null,
      "bbox_note": "section/page anchor; paragraph bbox not claimed"
    },
    {
      "id": "S006",
      "page": 8,
      "type": "note",
      "order": 8,
      "original_text": "",
      "english_paraphrase": "The evidence concerns pose and visible-surface geometry. It does not establish reconstruction of unobserved complete shapes.",
      "translation": "证据主要覆盖位姿和可见表面几何，未建立对未观测完整形状的恢复能力。",
      "source_kind": "paper-grounded-paraphrase",
      "confidence": "high",
      "bbox": null,
      "bbox_note": "section/page anchor; paragraph bbox not claimed"
    },
