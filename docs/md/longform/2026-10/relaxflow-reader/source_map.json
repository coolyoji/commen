  "glossary": [
    {
      "term": "amodal generation",
      "translation": "完整对象生成",
      "role": "在可见片段外补结构",
      "failure": "无新观测时仍有多解"
    },
    {
      "term": "observation fidelity",
      "translation": "观测保真",
      "role": "保持该实例可见证据",
      "failure": "先验可覆盖测量"
    },
    {
      "term": "semantic prior",
      "translation": "语义先验",
      "role": "选择隐藏解释",
      "failure": "有偏先验会选错真实实例"
    },
    {
      "term": "Multi-Prior Consensus",
      "translation": "多先验共识",
      "role": "拼接共同属性、稀释实例细节",
      "failure": "共同偏差反而被放大"
    },
    {
      "term": "low-pass relaxation",
      "translation": "低通松弛",
      "role": "平滑先验logits",
      "failure": "高频真信号也可能被抹"
    },
    {
      "term": "visibility-aware fusion",
      "translation": "可见性感知融合",
      "role": "依可见性分配引导",
      "failure": "pose错时权限分错"
    },
    {
      "term": "rectified flow",
      "translation": "整流流",
      "role": "从噪声到三维latent的速度",
      "failure": "非真实物体运动"
    },
    {
      "term": "Point-FID",
      "translation": "点特征分布距离",
      "role": "集合级语义比较",
      "failure": "不能替代隐藏面/拓扑误差"
    }
  ],
