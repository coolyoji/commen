  "glossary": [
    {
      "term": "JEPA",
      "translation": "预测缺失位置的抽象描述",
      "role": "特征先验，不画RGB",
      "failure": "同类别不同隐藏姿态"
    },
    {
      "term": "Tubelet",
      "translation": "视频的小块压缩单元",
      "role": "控制token量、建立时空上下文",
      "failure": "薄结构混进遮挡物"
    },
    {
      "term": "LoRA",
      "translation": "小型低秩权重更新",
      "role": "让encoder适配分割而少训参数",
      "failure": "不是零样本、仍受标注偏差"
    },
    {
      "term": "Predictor",
      "translation": "对删除位置提出特征",
      "role": "搬运预训练预测知识",
      "failure": "永久不可见、多解"
    },
    {
      "term": "Re-crop",
      "translation": "按首轮预测重新取样",
      "role": "修复输入支持域截断",
      "failure": "幻觉带偏、分辨率稀释"
    },
    {
      "term": "Fixed-frame scoring",
      "translation": "同一批帧、漏报记零",
      "role": "减少选择性漏报偏差",
      "failure": "单均值仍掩盖错误类型"
    }
