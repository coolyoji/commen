  "glossary": [
    {
      "term": "amodal mask",
      "translation": "包含被遮住部分的目标轮廓",
      "role": "定义目标归属与支持域",
      "failure": "缺失会混淆目标；扩张错误会逼模型补不存在区域"
    },
    {
      "term": "relative depth",
      "translation": "相对深度，刻度未必为米",
      "role": "用自然图像教师获得规模化几何监督",
      "failure": "当成米制会错误融合多视角"
    },
    {
      "term": "scale-and-shift alignment",
      "translation": "换刻度和零点",
      "role": "匹配可见区的规约，再外推",
      "failure": "近等深样本无法稳定分离两参数"
    },
    {
      "term": "guidance convolution",
      "translation": "条件卷积支路",
      "role": "把深度和轮廓接入已有表示",
      "failure": "没有条件会弱化目标选择；错误条件也会误导"
    },
    {
      "term": "Silog",
      "translation": "对数深度误差的尺度抑制项",
      "role": "降低整体比例对优化的影响",
      "failure": "不代表平移也无所谓；可见面积会影响梯度占比"
    },
    {
      "term": "conditional flow matching",
      "translation": "学条件速度场",
      "role": "在 latent 中学习图像到深度的路径",
      "failure": "没有新增测量，先验错误不会因“生成式”自动消失"
    },
    {
      "term": "pseudo ground truth",
      "translation": "伪真值，教师产物",
      "role": "替代难取得的完整深度监督",
      "failure": "教师偏差可被学生继承，必须用独立真值审计"
    }
  ],
